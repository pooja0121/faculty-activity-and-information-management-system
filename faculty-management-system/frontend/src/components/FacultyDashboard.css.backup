/* ================= Dark Theme Styles ================= */
.dark-theme { background-color: #1f2937; color: #f9fafb; }
.dark-theme .faculty-dashboard-container { background: #1f2937; }
.dark-theme .faculty-dashboard-header { background: linear-gradient(135deg, #374151 0%, #4b5563 100%); }
.dark-theme .faculty-id-box { background: #374151; color: #d1d5db; }
.dark-theme .sidebar-nav { background: #374151; border-right: 1px solid #4b5563; }
.dark-theme .nav-header { border-bottom: 1px solid #4b5563; }
.dark-theme .nav-header h3 { color: #f9fafb; }
.dark-theme .nav-item { color: #d1d5db; }
.dark-theme .nav-item:hover { background-color: #4b5563; }
.dark-theme .nav-item.active { background-color: #1e3a8a; color: #3b82f6; }
.dark-theme .nav-text { color: #d1d5db; }
.dark-theme .nav-item.active .nav-text { color: #3b82f6; }
.dark-theme .nav-account-section { border-top: 2px solid #4b5563; }
.dark-theme .nav-section-title { color: #9ca3af; }
.dark-theme .nav-item.logout { color: #f87171; }
.dark-theme .nav-item.logout:hover { background-color: #7f1d1d; }
.dark-theme .nav-item.logout .nav-text { color: #f87171; }
.dark-theme .main-content { background: #1f2937; }
.dark-theme .overview-content h2, .dark-theme .quick-stats h2, .dark-theme .profile-content h2, .dark-theme .settings-content h2 { color: #f9fafb; }
.dark-theme .overview-content p, .dark-theme .quick-stats p { color: #d1d5db; }
.dark-theme .portfolio-card { background: #374151; border: 1px solid #4b5563; }
.dark-theme .card-content h3 { color: #f9fafb; }
.dark-theme .card-content p { color: #d1d5db; }
.dark-theme .entry-count { color: #d1d5db; }
.dark-theme .quick-stats, .dark-theme .profile-content, .dark-theme .settings-content, .dark-theme .profile-container { background: #374151; border: 1px solid #4b5563; }
.dark-theme .profile-name { color: #f9fafb; }
.dark-theme .profile-faculty-id { color: #3b82f6; }
.dark-theme .profile-designation, .dark-theme .profile-department { color: #d1d5db; }
.dark-theme .contact-item { color: #d1d5db; }
.dark-theme .profile-stats { background: #374151; }
.dark-theme .stat-card { background: #4b5563; border: 1px solid #6b7280; }
.dark-theme .stat-content h3 { color: #3b82f6; }
.dark-theme .stat-content p { color: #d1d5db; }
.dark-theme .profile-section { background: #4b5563; border: 1px solid #6b7280; }
.dark-theme .section-header { background: #374151; border-bottom: 1px solid #6b7280; }
.dark-theme .section-header h3 { color: #f9fafb; }
.dark-theme .section-header p { color: #d1d5db; }
.dark-theme .section-content { background: #4b5563; }
.dark-theme .form-group label { color: #f9fafb; }
.dark-theme .form-group input, .dark-theme .form-group textarea, .dark-theme .form-group select { background: #374151; border: 1px solid #6b7280; color: #f9fafb; }
.dark-theme .form-group input:focus, .dark-theme .form-group textarea:focus, .dark-theme .form-group select:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
.dark-theme .form-group p { background: #374151; border: 1px solid #6b7280; color: #d1d5db; }
.dark-theme .profile-actions-bottom { border-top: 1px solid #6b7280; }
.dark-theme .btn-cancel { background: #4b5563; color: #d1d5db; border: 1px solid #6b7280; }
.dark-theme .btn-cancel:hover { background: #6b7280; }
.dark-theme .btn-save { background: #22c55e; color: white; }
.dark-theme .btn-save:hover { background: #16a34a; }
.dark-theme .file-input-label { background: #4b5563; color: #d1d5db; border: 2px dashed #6b7280; }
.dark-theme .file-input-label:hover { background: #6b7280; border-color: #3b82f6; color: #3b82f6; }
.dark-theme .file-info { background: #1e3a8a; border: 1px solid #3b82f6; }
.dark-theme .file-info p { color: #93c5fd; }
.dark-theme .file-preview { background: #4b5563; border: 1px solid #6b7280; }
.dark-theme .profile-picture-display { background: #4b5563; border: 1px solid #6b7280; }
.dark-theme .no-picture-text { color: #d1d5db; }
.dark-theme .save-message.success { background: #064e3b; color: #6ee7b7; border: 1px solid #059669; }
.dark-theme .save-message.error { background: #7f1d1d; color: #fca5a5; border: 1px solid #dc2626; }
.dark-theme .setting-item { border-bottom: 1px solid #4b5563; }
.dark-theme .setting-item label { color: #f9fafb; }
.dark-theme .setting-item select, .dark-theme .setting-item input { background: #374151; border: 1px solid #6b7280; color: #f9fafb; }
.dark-theme .setting-item select:focus, .dark-theme .setting-item input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
.dark-theme .btn-outline { border: 1.5px solid #3b82f6; color: #3b82f6; }
.dark-theme .btn-outline:hover { background-color: #3b82f6; color: white; }
.dark-theme .btn-edit-profile { background: #3b82f6; }
.dark-theme .btn-edit-profile:hover { background: #2563eb; }
.dark-theme .hamburger-line { background: #f9fafb; }
.dark-theme .hamburger-btn:hover .hamburger-line { background: #d1d5db; }
